---
import BaseLayout from './BaseLayout.astro';
import AppIcon from '../components/ui/AppIcon.astro';
import { getAppById } from '../data/apps';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  app: string;
  type: 'privacy' | 'terms' | 'guide';
  headings?: Heading[];
}

const { title, app, type, headings = [] } = Astro.props;

const appInfo = getAppById(app) || {
  id: app,
  name: app === 'universal-scanner' ? 'Universal Scanner' : app === 'music-bridge' ? 'Music Bridge' : 'CoSphere',
};

const docTitleMap = {
  privacy: 'Privacy Policy',
  terms: 'Terms of Usage',
  guide: 'User Guide & Help',
};
---

<BaseLayout title={`${title} — ${appInfo.name}`} activeApp={app}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Header Banner -->
    <div class="p-6 rounded-3xl border border-zinc-800 bg-zinc-900/80 backdrop-blur-xl flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <AppIcon appId={appInfo.id} appName={appInfo.name} size="lg" />
        <div class="space-y-1">
          <h1 class="text-xl sm:text-2xl font-bold text-white">{appInfo.name}</h1>
          <p class="text-xs text-zinc-400 font-medium">{docTitleMap[type]}</p>
        </div>
      </div>

      <!-- App Document Tabs -->
      <div class="flex items-center gap-2 bg-zinc-950 p-1.5 rounded-full border border-zinc-800">
        <a 
          href={`/${app}/guide/`} 
          class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
            type === 'guide' ? 'bg-white text-zinc-950 font-semibold shadow-sm' : 'text-zinc-400 hover:text-white'
          }`}
        >
          User Guide
        </a>
        <a 
          href={`/${app}/privacy/`} 
          class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
            type === 'privacy' ? 'bg-white text-zinc-950 font-semibold shadow-sm' : 'text-zinc-400 hover:text-white'
          }`}
        >
          Privacy Policy
        </a>
        <a 
          href={`/${app}/terms/`} 
          class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
            type === 'terms' ? 'bg-white text-zinc-950 font-semibold shadow-sm' : 'text-zinc-400 hover:text-white'
          }`}
        >
          Terms of Usage
        </a>
      </div>
    </div>

    <!-- 3-Column Reader Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Directory Sidebar (Col 1-3) -->
      <aside class="lg:col-span-3 space-y-4">
        <div class="p-5 rounded-2xl border border-zinc-800 bg-zinc-900/60 space-y-3">
          <div class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">DOCUMENT DIRECTORY</div>
          <ul class="space-y-1.5 text-xs font-medium text-zinc-400">
            <li>
              <a href={`/${app}/privacy/`} class={`block p-2 rounded-xl transition-all ${type === 'privacy' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-800/50 hover:text-white'}`}>
                🔒 Privacy Policy
              </a>
            </li>
            <li>
              <a href={`/${app}/terms/`} class={`block p-2 rounded-xl transition-all ${type === 'terms' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-800/50 hover:text-white'}`}>
                ⚖️ Terms of Usage
              </a>
            </li>
            <li>
              <a href={`/${app}/guide/`} class={`block p-2 rounded-xl transition-all ${type === 'guide' ? 'bg-zinc-800 text-white font-bold' : 'hover:bg-zinc-800/50 hover:text-white'}`}>
                📖 User Guide & Help
              </a>
            </li>
          </ul>
        </div>
      </aside>

      <!-- Center Document Article (Col 4-9) -->
      <main class="lg:col-span-6 p-6 sm:p-8 rounded-3xl border border-zinc-800 bg-zinc-900/80 shadow-xl">
        <article class="prose max-w-none">
          <slot />
        </article>
      </main>

      <!-- Right "On This Page" TOC Outline (Col 10-12) -->
      <aside class="lg:col-span-3 space-y-4 hidden lg:block sticky top-24">
        {headings.length > 0 && (
          <div class="p-5 rounded-2xl border border-zinc-800 bg-zinc-900/60 space-y-3">
            <div class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">ON THIS PAGE</div>
            <ul class="space-y-1.5 text-xs text-zinc-400 font-medium">
              {headings
                .filter((h) => h.depth <= 3)
                .map((h) => (
                  <li style={`padding-left: ${(h.depth - 1) * 8}px`}>
                    <a href={`#${h.slug}`} class="hover:text-white transition-colors block py-0.5 truncate">
                      {h.text}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>
