---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeApp?: string;
}

const {
  title,
  description = 'Cranbear — Privacy-first, high performance mobile applications.',
  activeApp,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/brand/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-zinc-950 text-white selection:bg-cyan-500 selection:text-black">
    <Header activeApp={activeApp} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
