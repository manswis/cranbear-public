---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeApp?: string;
}

const {
  title,
  description = 'Cranbear — Privacy-first, high performance mobile applications.',
  activeApp,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/brand/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- Safe Central Theme Manager (Anti-Flash + Safe LocalStorage) -->
    <script is:inline>
      (function() {
        function getSafeTheme() {
          try {
            return localStorage.getItem('theme');
          } catch (e) {
            return null;
          }
        }
        
        function setSafeTheme(val) {
          try {
            localStorage.setItem('theme', val);
          } catch (e) {}
        }

        window.__updateTheme = function(mode) {
          const html = document.documentElement;
          let isDark;

          if (mode === 'dark') {
            isDark = true;
          } else if (mode === 'light') {
            isDark = false;
          } else {
            isDark = !html.classList.contains('dark');
          }

          if (isDark) {
            html.classList.add('dark');
            setSafeTheme('dark');
          } else {
            html.classList.remove('dark');
            setSafeTheme('light');
          }
          return isDark;
        };

        const stored = getSafeTheme();
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const initialIsDark = stored === 'dark' || (!stored && prefersDark);
        
        if (initialIsDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-cyan-500 selection:text-black">
    <Header activeApp={activeApp} />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
