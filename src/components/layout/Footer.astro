---
import { APPS } from '../../data/apps';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-800/80 bg-zinc-950 text-zinc-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Top Footer Links Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 font-sans text-xs">
      <!-- Col 1: Brand Info -->
      <div class="space-y-3">
        <div class="flex items-center gap-2">
          <img src="/assets/brand/logo.png" alt="Cranbear Logo" class="w-6 h-6 rounded-lg" />
          <span class="text-sm font-bold text-white">Cranbear</span>
        </div>
        <p class="text-zinc-400 leading-relaxed">
          Crafting high performance, privacy-first mobile applications for users worldwide.
        </p>
      </div>

      <!-- Col 2: App Suite -->
      <div class="space-y-2">
        <div class="font-semibold text-white uppercase tracking-wider text-[11px]">Applications</div>
        <ul class="space-y-2">
          {APPS.map((app) => (
            <li>
              <a href={`/${app.id}/`} class="hover:text-white transition-colors">
                {app.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: User Guides -->
      <div class="space-y-2">
        <div class="font-semibold text-white uppercase tracking-wider text-[11px]">Help & Support</div>
        <ul class="space-y-2">
          {APPS.map((app) => (
            <li>
              <a href={`/${app.id}/guide/`} class="hover:text-white transition-colors">
                {app.name} Guide
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal -->
      <div class="space-y-2">
        <div class="font-semibold text-white uppercase tracking-wider text-[11px]">Legal & Policies</div>
        <ul class="space-y-2">
          <li><a href="/universal-scanner/privacy/" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/universal-scanner/terms/" class="hover:text-white transition-colors">Terms of Usage</a></li>
          <li><a href="mailto:cranbear.service@gmail.com" class="hover:text-white transition-colors">Contact Support</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="border-t border-zinc-900 pt-6 flex flex-wrap items-center justify-between text-xs text-zinc-400 gap-4">
      <div>
        © {currentYear} Cranbear. All rights reserved.
      </div>
      <div>
        Support: <a href="mailto:cranbear.service@gmail.com" class="text-zinc-300 hover:text-white">cranbear.service@gmail.com</a>
      </div>
    </div>
  </div>
</footer>
