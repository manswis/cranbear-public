---
import AppIcon from '../ui/AppIcon.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import { APPS } from '../../data/apps';

interface Props {
  activeApp?: string;
}

const { activeApp } = Astro.props;
---

<header class="sticky top-0 z-50 backdrop-blur-xl bg-white/90 dark:bg-zinc-950/90 border-b border-zinc-200 dark:border-zinc-800/80 transition-colors">
  <!-- Top Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-13 sm:h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group flex-shrink-0">
      <img src="/assets/brand/logo.png" alt="Cranbear Logo" class="w-6 h-6 sm:w-8 sm:h-8 rounded-xl border border-zinc-200 dark:border-zinc-800 group-hover:scale-105 transition-transform" />
      <span class="text-sm sm:text-lg font-bold tracking-tight text-zinc-900 dark:text-white font-sans group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">Cranbear</span>
    </a>

    <!-- Desktop App Switcher Nav Links -->
    <nav class="hidden md:flex items-center gap-1 bg-zinc-100 dark:bg-zinc-900/90 p-1 rounded-full border border-zinc-200 dark:border-zinc-800">
      <a 
        href="/" 
        class={`px-4 py-1.5 rounded-full text-xs font-medium transition-all ${
          !activeApp 
            ? 'bg-white dark:bg-zinc-100 text-zinc-950 font-semibold shadow-sm' 
            : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white'
        }`}
      >
        All Apps
      </a>

      {APPS.map((app) => (
        <a 
          href={`/${app.id}/`}
          class={`px-3.5 py-1.5 rounded-full text-xs font-medium transition-all ${
            activeApp === app.id 
              ? 'bg-white dark:bg-zinc-100 text-zinc-950 font-semibold shadow-sm' 
              : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white'
          }`}
        >
          {app.name}
        </a>
      ))}
    </nav>

    <!-- Minimal Non-Invasive Theme Selector -->
    <div class="flex items-center gap-2">
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile Native Segmented Slider -->
  <div class="md:hidden border-t border-zinc-200 dark:border-zinc-800/60 bg-zinc-50/95 dark:bg-zinc-950/95 px-2.5 py-1.5 overflow-x-auto scrollbar-none">
    <div class="inline-flex items-center gap-0.5 bg-zinc-200/80 dark:bg-zinc-900/90 p-0.5 rounded-full border border-zinc-300 dark:border-zinc-800/80 w-max">
      <a 
        href="/" 
        class={`px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold transition-all duration-200 active:scale-95 ${
          !activeApp 
            ? 'bg-white dark:bg-zinc-100 text-zinc-950 shadow-sm' 
            : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white'
        }`}
      >
        All Apps
      </a>

      {APPS.map((app) => {
        const isActive = activeApp === app.id;
        return (
          <a 
            href={`/${app.id}/`}
            class={`px-3 py-1 rounded-full text-[10px] sm:text-[11px] font-semibold transition-all duration-200 active:scale-95 whitespace-nowrap ${
              isActive 
                ? 'bg-white dark:bg-zinc-100 text-zinc-950 shadow-sm' 
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white'
            }`}
          >
            {app.name}
          </a>
        );
      })}
    </div>
  </div>
</header>

<style>
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
