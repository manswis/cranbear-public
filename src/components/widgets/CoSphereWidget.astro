---
---

<div class="relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/80 p-6 shadow-2xl backdrop-blur-md">
  <!-- Header Telemetry -->
  <div class="flex items-center justify-between border-b border-zinc-800/80 pb-4 mb-4 font-mono text-xs text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <span>HOUSING & GATE COMMAND</span>
    </div>
    <span class="text-zinc-500">SYNC ENGINE ACTIVE</span>
  </div>

  <!-- Command Center Live Panels -->
  <div class="grid grid-cols-2 gap-3">
    <!-- Panel 1: Gate Signal Access -->
    <div class="p-3.5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400">
        <span>GATE SIGNAL</span>
        <span class="text-emerald-400 font-bold">ONLINE</span>
      </div>
      <div class="text-lg font-mono font-bold text-white tracking-wide">
        BLOCK 4B <span class="text-xs text-zinc-400 font-normal">#G-102</span>
      </div>
      <div class="text-[10px] font-mono text-zinc-500 flex items-center justify-between">
        <span>RFID PASS VERIFIED</span>
        <span class="text-indigo-400">12:04 PM</span>
      </div>
    </div>

    <!-- Panel 2: Occupancy Rate -->
    <div class="p-3.5 rounded-xl bg-zinc-900/60 border border-zinc-800 flex flex-col justify-between space-y-2">
      <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400">
        <span>OCCUPANCY</span>
        <span class="text-indigo-400 font-bold">96.4%</span>
      </div>
      <div class="text-lg font-mono font-bold text-white tracking-wide">
        142 / 148 <span class="text-xs text-zinc-400 font-normal">UNITS</span>
      </div>
      <div class="w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden">
        <div class="h-full bg-indigo-500 rounded-full w-[96.4%]"></div>
      </div>
    </div>
  </div>

  <!-- Live Maintenance Dispatch Log -->
  <div class="mt-3 p-3 rounded-xl bg-zinc-900/40 border border-zinc-800/80 font-mono text-[11px] text-zinc-400 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
      <span class="text-zinc-300">DISPATCH: HVAC Maintenance</span>
    </div>
    <span class="text-zinc-500">PRIORITY HIGH</span>
  </div>
</div>
