---
---

<div class="relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950/80 p-6 shadow-2xl backdrop-blur-md">
  <!-- Header Telemetry -->
  <div class="flex items-center justify-between border-b border-zinc-800/80 pb-4 mb-4 font-mono text-xs text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>ON-DEVICE ML SCANNER</span>
    </div>
    <span class="text-zinc-500">60 FPS // LOCAL</span>
  </div>

  <!-- Interactive QR Scan Area -->
  <div class="relative flex flex-col items-center justify-center p-6 border border-zinc-800/60 rounded-xl bg-zinc-900/50 industrial-grid-dense group">
    <!-- Corner Targeting Brackets -->
    <div class="absolute top-3 left-3 w-4 h-4 border-t-2 border-l-2 border-emerald-500"></div>
    <div class="absolute top-3 right-3 w-4 h-4 border-t-2 border-r-2 border-emerald-500"></div>
    <div class="absolute bottom-3 left-3 w-4 h-4 border-b-2 border-l-2 border-emerald-500"></div>
    <div class="absolute bottom-3 right-3 w-4 h-4 border-b-2 border-r-2 border-emerald-500"></div>

    <!-- Animated Scanning Laser Line -->
    <div class="absolute inset-x-4 top-0 h-0.5 bg-gradient-to-r from-transparent via-emerald-400 to-transparent shadow-[0_0_15px_#10b981] animate-[scan_2.5s_ease-in-out_infinite]"></div>

    <!-- Stylized QR Grid Graphic -->
    <div class="grid grid-cols-7 gap-1.5 p-4 bg-zinc-950/90 border border-zinc-800 rounded-lg text-emerald-400 shadow-inner">
      <div class="w-6 h-6 border-2 border-emerald-500 flex items-center justify-center p-1"><div class="w-full h-full bg-emerald-500"></div></div>
      <div class="w-6 h-6 bg-emerald-500/20 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/80 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/30 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/70 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/20 rounded-xs"></div>
      <div class="w-6 h-6 border-2 border-emerald-500 flex items-center justify-center p-1"><div class="w-full h-full bg-emerald-500"></div></div>
      
      <div class="w-6 h-6 bg-emerald-500/40 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/10 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/90 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/30 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/80 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/20 rounded-xs"></div>

      <div class="w-6 h-6 border-2 border-emerald-500 flex items-center justify-center p-1"><div class="w-full h-full bg-emerald-500"></div></div>
      <div class="w-6 h-6 bg-emerald-500/30 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/80 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/50 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/90 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/10 rounded-xs"></div>
      <div class="w-6 h-6 bg-emerald-500/60 rounded-xs"></div>
    </div>

    <!-- Live Telemetry Status Output -->
    <div class="mt-4 font-mono text-[11px] text-zinc-400 bg-zinc-950/80 px-3 py-1.5 rounded border border-zinc-800/80 flex items-center gap-2">
      <span class="text-emerald-400">STATUS:</span>
      <span>DECODED [QR_CODE] -> 0.002s</span>
    </div>
  </div>
</div>

<style>
  @keyframes scan {
    0%, 100% { top: 12px; }
    50% { top: calc(100% - 12px); }
  }
</style>
