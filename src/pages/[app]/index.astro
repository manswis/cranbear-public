---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppIcon from '../../components/ui/AppIcon.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ScreenshotCarousel from '../../components/ui/ScreenshotCarousel.astro';
import { APPS, getAppById } from '../../data/apps';

export function getStaticPaths() {
  return APPS.map((app) => ({
    params: { app: app.id },
  }));
}

const { app } = Astro.params;
const appDetails = getAppById(app)!;
---

<BaseLayout title={`${appDetails.name} — Cranbear Application`} activeApp={app}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-8 sm:space-y-10">
    <!-- Header Block -->
    <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl border skin-card backdrop-blur-xl flex flex-col sm:flex-row sm:items-start justify-between gap-5">
      <div class="flex items-center gap-3.5 sm:gap-5">
        <AppIcon appId={appDetails.id} appName={appDetails.name} size="lg" />
        <div class="space-y-1">
          <div class="flex flex-wrap items-center gap-2">
            <h1 class="text-2xl sm:text-3xl font-bold skin-text-primary">{appDetails.name}</h1>
            <Badge status={appDetails.status} />
          </div>
          <p class="text-xs sm:text-sm skin-text-muted font-medium">{appDetails.category} • {appDetails.tagline}</p>
        </div>
      </div>

      <!-- Quick Actions Grid: 4 Symmetric Pills on Mobile -->
      <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-2 pt-2 sm:pt-0 w-full sm:w-auto">
        {appDetails.playStoreUrl ? (
          <a 
            href={appDetails.playStoreUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center font-semibold rounded-full bg-emerald-600 hover:bg-emerald-500 text-white shadow-md transition-all px-2.5 py-1 text-[10px] sm:text-xs sm:px-3.5 sm:py-1.5 gap-1 whitespace-nowrap active:scale-95"
          >
            <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 512 512" fill="none">
              <path d="M325.8 243.8L74.8 494.8C65.5 504.1 50.4 497.5 50.4 484.4V27.6C50.4 14.5 65.5 7.9 74.8 17.2L325.8 268.2C332.5 274.9 332.5 285.8 325.8 292.5" fill="#00D2FF"/>
              <path d="M386.7 304.7L325.8 243.8L74.8 494.8L386.7 322.7C395 318.1 395 309.3 386.7 304.7Z" fill="#00F076"/>
              <path d="M386.7 187.3L74.8 15.2L325.8 268.2L386.7 207.3C395 202.7 395 191.9 386.7 187.3Z" fill="#FF3A44"/>
              <path d="M461.5 243.8L386.7 304.7L325.8 268.2L386.7 207.3L461.5 268.2C469.8 272.8 469.8 281.6 461.5 286.2Z" fill="#FFC107"/>
            </svg>
            <span>Google Play</span>
          </a>
        ) : (
          <span class="inline-flex items-center justify-center font-medium rounded-full bg-zinc-200/80 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 border border-zinc-300 dark:border-zinc-700/80 px-2.5 py-1 text-[10px] sm:text-xs sm:px-3.5 sm:py-1.5 gap-1 whitespace-nowrap opacity-75">
            <svg class="w-3.5 h-3.5 flex-shrink-0 grayscale opacity-70" viewBox="0 0 512 512" fill="none">
              <path d="M325.8 243.8L74.8 494.8C65.5 504.1 50.4 497.5 50.4 484.4V27.6C50.4 14.5 65.5 7.9 74.8 17.2L325.8 268.2C332.5 274.9 332.5 285.8 325.8 292.5" fill="#00D2FF"/>
              <path d="M386.7 304.7L325.8 243.8L74.8 494.8L386.7 322.7C395 318.1 395 309.3 386.7 304.7Z" fill="#00F076"/>
              <path d="M386.7 187.3L74.8 15.2L325.8 268.2L386.7 207.3C395 202.7 395 191.9 386.7 187.3Z" fill="#FF3A44"/>
              <path d="M461.5 243.8L386.7 304.7L325.8 268.2L386.7 207.3L461.5 268.2C469.8 272.8 469.8 281.6 461.5 286.2Z" fill="#FFC107"/>
            </svg>
            <span>Coming Soon</span>
          </span>
        )}
        <Button href={`/${appDetails.id}/guide/`} variant="secondary" size="sm">
          User Guide
        </Button>
        <Button href={`/${appDetails.id}/privacy/`} variant="outline" size="sm">
          Privacy Policy
        </Button>
        <Button href={`/${appDetails.id}/terms/`} variant="outline" size="sm">
          Terms of Use
        </Button>
      </div>
    </div>

    <!-- Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl border skin-card space-y-3 sm:space-y-4">
        <h2 class="text-lg sm:text-xl font-bold skin-text-primary">Product Overview</h2>
        <p class="skin-text-secondary leading-relaxed text-xs sm:text-sm">
          {appDetails.description}
        </p>
      </div>

      <div class="p-5 sm:p-8 rounded-2xl sm:rounded-3xl border skin-card space-y-3 sm:space-y-4">
        <h2 class="text-lg sm:text-xl font-bold skin-text-primary">Core Capabilities</h2>
        <ul class="space-y-2 text-xs skin-text-primary">
          {appDetails.features.map((feat) => (
            <li class="flex items-center gap-2.5 skin-elevated p-2.5 rounded-xl border">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Screenshot Gallery -->
    {appDetails.screenshots && appDetails.screenshots.length > 0 && (
      <div class="space-y-3 sm:space-y-4 pt-4 sm:pt-6 border-t border-zinc-200 dark:border-zinc-800/80">
        <h2 class="text-lg sm:text-xl font-bold skin-text-primary">Interface Gallery ({appDetails.screenshots.length})</h2>
        <ScreenshotCarousel appId={appDetails.id} screenshots={appDetails.screenshots} appName={appDetails.name} />
      </div>
    )}
  </div>
</BaseLayout>
