---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIcon from '../components/ui/AppIcon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ScreenshotCarousel from '../components/ui/ScreenshotCarousel.astro';
import { APPS } from '../data/apps';
---

<BaseLayout title="Cranbear — Apps Built for Privacy & Performance">
  <!-- Hero Section (Apple Feature Banner Style) -->
  <section class="py-14 sm:py-20 text-center space-y-4 max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-800 bg-zinc-900/80 text-xs font-semibold text-zinc-300 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>ENGINEERED FOR PRIVACY & SPEED</span>
    </div>

    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white font-sans">
      Apps Built for <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-indigo-500">Simplicity & Privacy</span>
    </h1>

    <p class="text-lg text-zinc-400 font-sans max-w-2xl mx-auto leading-relaxed">
      Powerful mobile software crafted to be effortless for everyone. No complicated setup, no intrusive tracking—just clean, reliable tools.
    </p>

    <div class="flex items-center justify-center gap-3 pt-2">
      <Button href="#apps" variant="primary" size="lg">
        EXPLORE APPS
      </Button>
      <Button href="mailto:cranbear.service@gmail.com" variant="outline" size="lg">
        CONTACT SUPPORT
      </Button>
    </div>
  </section>

  <!-- Apps Showcase Section (Apple Feature Cards Grid) -->
  <section id="apps" class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="text-center space-y-1">
      <div class="text-xs font-semibold text-cyan-400 uppercase tracking-widest">PRODUCT ECOSYSTEM</div>
      <h2 class="text-2xl sm:text-3xl font-bold text-white">Our Applications</h2>
    </div>

    <div class="space-y-8">
      {APPS.map((app) => (
        <div class="rounded-3xl border border-zinc-800 bg-zinc-900/80 p-6 sm:p-8 shadow-xl backdrop-blur-xl space-y-6">
          <!-- Card Header Block -->
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-zinc-800/80 pb-5">
            <div class="flex items-center gap-4">
              <AppIcon appId={app.id} appName={app.name} size="lg" />
              <div class="space-y-1">
                <div class="flex items-center gap-3">
                  <h3 class="text-2xl font-bold text-white">{app.name}</h3>
                  <Badge status={app.status} />
                </div>
                <p class="text-xs text-zinc-400 font-medium">{app.category} • {app.tagline}</p>
              </div>
            </div>

            <!-- Quick Actions -->
            <div class="flex flex-wrap items-center gap-2">
              {app.playStoreUrl && (
                <Button href={app.playStoreUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="sm">
                  <svg class="w-3.5 h-3.5 mr-1 inline-block fill-current" viewBox="0 0 24 24"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L18.81,13.97C20.12,13.22 20.12,11.78 18.81,11.03L16.81,9.88L14.81,11.88L16.81,15.12M4.5,3.15L13.69,12.34L14.81,11.22M4.5,20.85L14.81,12.78L13.69,11.66"/></svg>
                  GET ON GOOGLE PLAY
                </Button>
              )}
              <Button href={`/${app.id}/guide/`} variant="secondary" size="sm">
                USER GUIDE
              </Button>
              <Button href={`/${app.id}/privacy/`} variant="outline" size="sm">
                PRIVACY POLICY
              </Button>
            </div>
          </div>

          <!-- Description & Feature Checklist -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-3">
              <p class="text-zinc-300 leading-relaxed text-sm font-sans">
                {app.description}
              </p>
            </div>

            <div class="space-y-2">
              <div class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">KEY SPECIFICATIONS:</div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-zinc-300 font-sans">
                {app.features.map((feat) => (
                  <li class="flex items-start gap-2 bg-zinc-950/60 p-2.5 rounded-xl border border-zinc-800/80">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Interface Screenshots Carousel -->
          {app.screenshots && app.screenshots.length > 0 && (
            <div class="pt-4 border-t border-zinc-800/60 space-y-2">
              <div class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">INTERFACE GALLERY ({app.screenshots.length}):</div>
              <ScreenshotCarousel appId={app.id} screenshots={app.screenshots} appName={app.name} />
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
