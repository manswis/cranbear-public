---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppIcon from '../components/ui/AppIcon.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import ScreenshotCarousel from '../components/ui/ScreenshotCarousel.astro';
import { APPS } from '../data/apps';
---

<BaseLayout title="Cranbear — Apps Built for Privacy & Performance">
  <!-- Hero Section -->
  <section class="py-10 sm:py-16 text-center space-y-4 max-w-4xl mx-auto px-4">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border skin-card text-[11px] sm:text-xs font-semibold shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
      <span>ENGINEERED FOR PRIVACY & SPEED</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight skin-text-primary font-sans">
      Apps Built for <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-cyan-600 to-indigo-600 dark:from-emerald-400 dark:via-cyan-400 dark:to-indigo-500">Simplicity & Privacy</span>
    </h1>

    <p class="text-sm sm:text-base skin-text-secondary font-sans max-w-2xl mx-auto leading-relaxed">
      Powerful mobile software crafted to be effortless for everyone. No complicated setup, no intrusive tracking—just clean, reliable tools.
    </p>

    <div class="flex items-center justify-center gap-2.5 pt-2">
      <Button href="#apps" variant="primary" size="md">
        Explore Apps
      </Button>
      <Button href="mailto:cranbear.service@gmail.com" variant="outline" size="md">
        Contact Support
      </Button>
    </div>
  </section>

  <!-- Apps Showcase Section -->
  <section id="apps" class="py-6 sm:py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-10">
    <div class="text-center space-y-1">
      <div class="text-[11px] font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-widest">PRODUCT ECOSYSTEM</div>
      <h2 class="text-2xl sm:text-3xl font-bold skin-text-primary">Our Applications</h2>
    </div>

    <div class="space-y-6 sm:space-y-8">
      {APPS.map((app) => (
        <div class="rounded-2xl sm:rounded-3xl border skin-card p-4 sm:p-8 backdrop-blur-xl space-y-5 sm:space-y-6">
          <!-- Card Header Block -->
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-zinc-200 dark:border-zinc-800/80 pb-4 sm:pb-5">
            <div class="flex items-center gap-3 sm:gap-4">
              <AppIcon appId={app.id} appName={app.name} size="md" />
              <div class="space-y-0.5 sm:space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-xl sm:text-2xl font-bold skin-text-primary">{app.name}</h3>
                  <Badge status={app.status} />
                </div>
                <p class="text-xs skin-text-muted font-medium">{app.category} • {app.tagline}</p>
              </div>
            </div>

            <!-- Quick Actions Grid -->
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-2 pt-2 sm:pt-0">
              {app.playStoreUrl && (
                <Button href={app.playStoreUrl} target="_blank" rel="noopener noreferrer" variant="primary" size="sm" class="col-span-2 sm:col-span-1">
                  <svg class="w-3.5 h-3.5 mr-1 inline-block fill-current" viewBox="0 0 24 24"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L18.81,13.97C20.12,13.22 20.12,11.78 18.81,11.03L16.81,9.88L14.81,11.88L16.81,15.12M4.5,3.15L13.69,12.34L14.81,11.22M4.5,20.85L14.81,12.78L13.69,11.66"/></svg>
                  Google Play
                </Button>
              )}
              <Button href={`/${app.id}/guide/`} variant="secondary" size="sm">
                User Guide
              </Button>
              <Button href={`/${app.id}/privacy/`} variant="outline" size="sm">
                Privacy Policy
              </Button>
              <Button href={`/${app.id}/terms/`} variant="outline" size="sm">
                Terms of Use
              </Button>
            </div>
          </div>

          <!-- Description & Feature Checklist -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            <div class="space-y-3">
              <p class="skin-text-secondary leading-relaxed text-xs sm:text-sm font-sans">
                {app.description}
              </p>
            </div>

            <div class="space-y-2">
              <div class="text-[11px] font-semibold skin-text-muted uppercase tracking-wider">KEY SPECIFICATIONS:</div>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs skin-text-primary font-sans">
                {app.features.map((feat) => (
                  <li class="flex items-start gap-2 skin-elevated p-2 sm:p-2.5 rounded-xl border">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Interface Screenshots Carousel -->
          {app.screenshots && app.screenshots.length > 0 && (
            <div class="pt-3 sm:pt-4 border-t border-zinc-200 dark:border-zinc-800/60 space-y-2">
              <div class="text-[11px] font-semibold skin-text-muted uppercase tracking-wider">INTERFACE GALLERY ({app.screenshots.length}):</div>
              <ScreenshotCarousel appId={app.id} screenshots={app.screenshots} appName={app.name} />
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
